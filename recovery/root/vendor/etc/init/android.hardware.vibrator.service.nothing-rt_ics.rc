service vendor.qti.vibrator /system/bin/aera-vibrator-service
    class hal
    user root
    group root input
    setenv RICHTAP_DEVICE_PATH  /dev/aw86927_haptic
    setenv ENV_RICHTAP_CONFIG_PATH /system/etc/aera-haptics/aac_richtap.config
    setenv LD_LIBRARY_PATH /system/lib64/aera-haptics:/system/lib64:/system/lib64/bootstrap
    disabled
    seclabel u:r:recovery:s0

on property:persist.sys.sfdc=*
        setprop persist.vendor.sfdc ${persist.sys.sfdc}
        
on property:persist.sys.sfdc.ntc=*
    setprop persist.vendor.sfdc.ntc ${persist.sys.sfdc.ntc}
    
